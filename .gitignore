# 构建产物（由 CF 构建时生成，不进仓库）
/dist/
__pycache__/
*.pyc

# 依赖
node_modules/

# 本地开发临时文件（下划线前缀）
_*
!.gitignore
!.python-version

# 保留引擎快照（构建必需，必须在 _* 之后取反）
!_engine_snapshot.pyc

# 但 Cloudflare Pages Functions 必需的共享模块以下划线前缀，必须进仓库
!functions/_lib/
!functions/admin/_ui.js

# 工作台 / 素材草稿目录（非站点必需）
/assets/
/vendor_src/
/mcp_server/

# 系统
.DS_Store
Thumbs.db

# wrangler 本地缓存
.wrangler/

# 构建产物：每次 gen_vibecode.py 重新生成，体积大且易变
vibecode-term-studio.html
# 临时部署副本（daily_term_update.py 生成）
.deploy*
