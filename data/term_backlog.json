      "vd_bad": "<div class='m-phone'><div class='m-body'><div style='display:flex;gap:6px'><span style='padding:6px 14px;background:#C8442E;color:#fff;border-radius:6px;font-size:10px'>保存</span><span style='padding:6px 10px;background:#eee;color:#666;border-radius:6px;font-size:10px'>导出</span></div></div></div>",
      "vd_good": "<div class='m-phone'><div class='m-body'><div style='display:inline-flex;align-items:stretch;border-radius:6px;overflow:hidden'><span style='padding:6px 14px;background:#C8442E;color:#fff;font-size:10px'>保存</span><span style='padding:6px 8px;background:#a8361f;color:#fff;font-size:10px'>▾</span></div><div style='position:absolute;right:14px;top:40px;background:#fff;border:1px solid #eee;border-radius:6px;font-size:9px;color:#333;padding:4px 10px'>另存为…</div></div></div>"
