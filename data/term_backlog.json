      "vd_bad": "<div class='m-phone'><div class='m-body'><div style='padding:8px 18px;background:#C8442E;color:#fff;border-radius:6px;font-size:10px'>点我</div><div style='font-size:9px;color:#bbb;margin-top:8px'>点了没反应…</div></div></div>",
      "vd_good": "<div class='m-phone'><div class='m-body'><div style='position:relative;overflow:hidden;padding:8px 18px;background:#C8442E;color:#fff;border-radius:6px;font-size:10px'>点我<span style='position:absolute;left:14px;top:6px;width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,.6)'></span></div></div></div>"
